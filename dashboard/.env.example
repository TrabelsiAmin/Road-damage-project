# Road Damage RAG API (optional).
# Public base URL of the Colab notebook after ngrok starts, for example:
#   VITE_RAG_API_URL=https://your-session.ngrok-free.app
# A trailing /ask is ignored. Leave the value empty when the notebook is not
# running: the dashboard then says the technical assistant is unavailable.
# Do not put an ngrok token or any other secret in this file. The address
# changes every Colab session.
#
# The Vite dev server proxies same-origin /rag/* to this origin and adds
# ngrok-skip-browser-warning. The browser does not call ngrok directly.
VITE_RAG_API_URL=
