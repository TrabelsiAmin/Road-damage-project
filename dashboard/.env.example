# Road Damage RAG API (optional).
# Leave this empty for the defense. The assistant then stays unavailable.
# Colab disallows remote proxies and using the notebook as a hidden web service.
# Set an address only when FastAPI runs on the same computer as Vite, for example:
#   VITE_RAG_API_URL=http://127.0.0.1:8000
# A trailing /ask is ignored. Do not put a token or any other secret here.
#
# The Vite dev server proxies same-origin /rag/* to this origin.
# The browser does not call that origin directly.
VITE_RAG_API_URL=

# Placeholders only. Copy to .env.local for a Vite run.
# Do not put a service-role key here. A public anon key is not a service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
